# ==============================================================================
# Configurações de Ambiente - Reusable AI Backend Architecture
# ==============================================================================
# Copie este arquivo para .env para execução local via Docker Compose ou Bare Metal:
# cp .env.example .env
#
# IMPORTANTE: Os valores padrão abaixo são estritamente para DESENVOLVIMENTO LOCAL.
# Em produção, o AI Gateway opera em modo FAIL-CLOSED, rejeitando chaves padrão,
# valores de demonstração e credenciais com menos de 16 caracteres de entropia.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambiente Operacional do AI Gateway
# ------------------------------------------------------------------------------
# Valores aceitos: desenvolvimento, teste, homologacao, producao
# (Aliases suportados: development, dev, test, staging, stage, production, prod)
# Em producao, o gateway aborta a inicialização se credenciais seguras não forem fornecidas.
GATEWAY_AMBIENTE=desenvolvimento
GATEWAY_PORTA=8000

# ------------------------------------------------------------------------------
# 2. Autenticação, Identidade e Anti-Spoofing (SEC-001)
# ------------------------------------------------------------------------------
# Chave de API Mestre (autenticação de clientes via cabeçalho X-API-Key ou Bearer token)
# Para produção, gere uma chave com alta entropia (mínimo 32 bytes URL-safe):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=dev-local-master-key-12345678

# Chaves de serviços M2M confiáveis autorizados a representar usuários (separadas por vírgula)
GATEWAY_CHAVES_CONFIAVEIS=dev-service-m2m-key-12345678
GATEWAY_PERMITIR_DELEGACAO_M2M=true

# ------------------------------------------------------------------------------
# 3. Roteamento de Modelos e Timeouts
# ------------------------------------------------------------------------------
# Modelo padrão a ser utilizado nas inferências caso não especificado no payload
GATEWAY_MODELO_PADRAO=modelo-teste
GATEWAY_TIMEOUT_SEGUNDOS=60.0

# ------------------------------------------------------------------------------
# 4. Persistência Conversacional e Isolamento Multilocatário
# ------------------------------------------------------------------------------
# Mecanismo de persistência: memoria, sqlite, postgresql
GATEWAY_MEMORIA_TIPO=postgresql

# Configurações para SQLite (utilizado quando GATEWAY_MEMORIA_TIPO=sqlite)
GATEWAY_SQLITE_PATH=:memory:

# Configurações do PostgreSQL 17 (utilizadas pelo Compose e pelo Gateway)
POSTGRES_DB=ia_conversas
POSTGRES_USER=usuario_ia
POSTGRES_PASSWORD=senha_ia_local
GATEWAY_POSTGRES_POOL_SIZE=10

# URL de conexão montada automaticamente pelo Compose ou configurada manualmente:
# GATEWAY_POSTGRES_URL=postgresql://usuario_ia:senha_ia_local@postgres:5432/ia_conversas
# Para execução bare-metal local apontando para localhost:
# GATEWAY_POSTGRES_URL=postgresql://usuario_ia:senha_ia_local@localhost:5432/ia_conversas

# ------------------------------------------------------------------------------
# 5. Aplicação Piloto e Camada Intermediária BFF (SEC-004, SEC-009)
# ------------------------------------------------------------------------------
# Habilita ou desabilita a interface web do piloto e endpoints BFF (/piloto/*)
# Por padrão: habilitado em desenvolvimento, desabilitado (fail-closed) em produção.
GATEWAY_PILOTO_HABILITADO=true

# Segredo dedicado para assinatura criptográfica HMAC-SHA256 dos cookies de sessão
# OBRIGATÓRIO em produção se o piloto estiver habilitado. Nunca reutilize a GATEWAY_API_KEY.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_PILOTO_SEGREDO_SESSAO=dev-piloto-secret-key-12345678

# ------------------------------------------------------------------------------
# 6. Observabilidade e Métricas Prometheus (SEC-008)
# ------------------------------------------------------------------------------
# Habilita a exposição de métricas no endpoint GET /metrics
GATEWAY_METRICAS_HABILITADAS=true

# Token dedicado para autenticação do scraper Prometheus (Authorization: Bearer <token>)
# Em produção, se omitido e GATEWAY_API_KEY também estiver ausente, /metrics retorna 403.
GATEWAY_METRICAS_TOKEN=dev-metrics-token-12345678

# ------------------------------------------------------------------------------
# 7. Rastreamento Distribuído (OpenTelemetry - OTLP)
# ------------------------------------------------------------------------------
# Habilita o rastreador OpenTelemetry e a propagação do cabeçalho W3C traceparent
OTEL_HABILITADO=true
OTEL_SERVICE_NAME=ai-gateway

# Endpoint do coletor OpenTelemetry (HTTP Protobuf na porta padrão 4318)
# Se omitido ou indisponível, a plataforma utiliza buffer circular em memória (fallback)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ------------------------------------------------------------------------------
# 8. Inferência Local Opcional (Ollama)
# ------------------------------------------------------------------------------
# O serviço Ollama no docker-compose é iniciado exclusivamente via profile:
# docker compose --profile ollama up -d
OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------------------------------------------
# 9. Provedores LLM Externos (Opcionais - Definir apenas para uso real)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 10. Configurações para Execução de Testes
# ------------------------------------------------------------------------------
# Quando true, força a execução mandatória dos testes com PostgreSQL 17 real
# POSTGRES_OBRIGATORIO=false
