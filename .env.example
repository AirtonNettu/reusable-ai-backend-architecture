# ==============================================================================
# Configurações de Ambiente - Reusable AI Backend Architecture
# ==============================================================================
# Copie este arquivo para .env ao executar localmente via Docker Compose:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ambiente e Segurança Operacional do AI Gateway
# ------------------------------------------------------------------------------
# Valores aceitos: desenvolvimento, teste, homologacao, producao
# Em producao, o gateway opera em modo fail-closed exigindo chaves com alta entropia.
GATEWAY_AMBIENTE=desenvolvimento
GATEWAY_PORTA=8000

# Chave de API Mestre (usada para autenticação de clientes no header X-API-Key)
# Em desenvolvimento, um valor padrão é aceito. Em produção, use valores gerados criptograficamente:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=dev-local-master-key-12345678

# Chaves de serviços M2M confiáveis autorizados a representar usuários (separadas por vírgula)
GATEWAY_CHAVES_CONFIAVEIS=dev-service-m2m-key-12345678
GATEWAY_PERMITIR_DELEGACAO_M2M=true

# ------------------------------------------------------------------------------
# Roteamento de Modelos e Timeouts
# ------------------------------------------------------------------------------
GATEWAY_MODELO_PADRAO=modelo-teste
GATEWAY_TIMEOUT_SEGUNDOS=60.0

# ------------------------------------------------------------------------------
# Persistência de Conversas e Isolamento Multilocatário
# ------------------------------------------------------------------------------
# Tipo de persistência: memoria, sqlite, postgresql
GATEWAY_MEMORIA_TIPO=postgresql

# Configurações do PostgreSQL 17 (utilizadas pelo Compose e pelo Gateway)
POSTGRES_DB=ia_conversas
POSTGRES_USER=usuario_ia
POSTGRES_PASSWORD=senha_ia_local
GATEWAY_POSTGRES_POOL_SIZE=10

# URL de conexão montada automaticamente no Compose ou definida manualmente:
# GATEWAY_POSTGRES_URL=postgresql://usuario_ia:senha_ia_local@postgres:5432/ia_conversas

# ------------------------------------------------------------------------------
# Inferência Local Opcional (Ollama)
# ------------------------------------------------------------------------------
# O serviço Ollama é iniciado apenas com o perfil explícito:
# docker compose --profile ollama up -d
OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------------------------------------------
# Provedores LLM Externos (Opcionais - Definir apenas se for utilizar)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
